{
  "name": "jelly-grid",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio playable ad: a jelly block puzzle built with PixiJS v8 and GSAP",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:mraid": "vite --mode applovin",
    "build": "node scripts/build-all.ts",
    "typecheck": "tsc --noEmit",
    "showcase": "node scripts/build-showcase.ts",
    "showcase:preview": "vite preview"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "fflate": "^0.8.2",
    "qrcode": "^1.5.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
